# ============================================
# 后端运行时镜像 — 本地已 mvn package，此处仅复制 jar
# JVM 128MB，适配 2G 服务器
# ============================================

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# 复制本地构建好的 jar（需先在本地执行 npm run build:backend）
COPY java-backend/target/*.jar app.jar

ENV JAVA_OPTS="-Xms64m -Xmx128m -XX:+UseSerialGC -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=32m -Xss256k -XX:+ExitOnOutOfMemoryError -XX:+UseContainerSupport"

USER appuser
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
  CMD wget -q -O /dev/null http://localhost:8080/api/health || exit 1
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]