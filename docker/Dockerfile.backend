# 后端镜像 — 多阶段构建：先编译 JAR 再打包运行
# 阶段1：Maven 编译
FROM maven:3.9-eclipse-temurin-21-alpine AS builder
WORKDIR /build
COPY java-backend/pom.xml .
# 先下载依赖（利用 Docker 缓存层）
RUN mvn dependency:go-offline -q || true
COPY java-backend/src ./src
RUN mvn package -DskipTests -q

# 阶段2：运行镜像
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
COPY --from=builder /build/target/*.jar app.jar

ENV JAVA_OPTS="-Xms64m -Xmx128m -XX:+UseSerialGC -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=32m -Xss256k -XX:+ExitOnOutOfMemoryError -XX:+UseContainerSupport"

USER appuser
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
  CMD wget -q -O /dev/null http://localhost:8080/api/health || exit 1
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
