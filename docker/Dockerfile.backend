# ============================================================
# CodeBlog 后端 Dockerfile — 为 2核2G 服务器优化
# 多阶段构建：Maven 打包 → JRE 运行
# ============================================================

FROM maven:3.9-eclipse-temurin-21-alpine AS builder

WORKDIR /build

# 替换 Alpine 软件源为国内镜像
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories

# Maven 构建内存限制
ENV MAVEN_OPTS="-Xmx384m -XX:+UseSerialGC"

# 复制源码和 settings.xml（阿里云 Maven 镜像）
COPY pom.xml settings.xml ./
COPY src ./src

# 直接打包（跳过 go-offline 避免插件下载失败）
RUN mvn package -s settings.xml -DskipTests -B

# ==================== 运行阶段 ====================
FROM eclipse-temurin:21-jre-alpine AS runtime

WORKDIR /app

RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories && \
    apk add --no-cache curl tzdata && \
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone

RUN addgroup -S appgroup && adduser -S appuser -G appgroup
RUN mkdir -p /app/uploads && chown -R appuser:appgroup /app

COPY --from=builder /build/target/*.jar app.jar

USER appuser

# JVM 参数：堆内存 256M，SerialGC（低内存最优）
ENV JAVA_OPTS="-Xmx256m -Xms128m -XX:+UseSerialGC -XX:MaxRAM=300m -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom"

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --retries=5 --start-period=60s \
    CMD curl -f http://localhost:8080/api/users/check || exit 1

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
