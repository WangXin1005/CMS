# ============================================================
# Nuxt 4 前端 — 多阶段构建 Dockerfile
# 阶段1：Node.js 构建（npm ci + nuxt build）
# 阶段2：Node.js 运行（精简生产依赖）
# ============================================================

# ---- 阶段1：构建 ----
FROM node:22-alpine AS builder

WORKDIR /build

# 复制依赖清单（利用 Docker 层缓存）
COPY package.json package-lock.json ./

# 安装依赖（使用 npm ci 确保可复现构建）
RUN npm ci --omit=dev --ignore-scripts 2>&1 && \
    npm ci --ignore-scripts 2>&1

# 复制源码
COPY . .

# Nuxt 构建（生成 .output 目录）
RUN npm run build

# ---- 阶段2：运行 ----
FROM node:22-alpine AS runtime

WORKDIR /app

# 安装 curl 用于 healthcheck
RUN apk add --no-cache curl tzdata && \
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone

# 创建非 root 用户
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# 从构建阶段复制产出物
COPY --from=builder /build/.output ./.output
COPY --from=builder /build/package.json /build/package-lock.json ./
COPY --from=builder /build/node_modules ./node_modules

# 设置权限
RUN chown -R appuser:appgroup /app

USER appuser

# Node.js 内存限制（2GB 服务器专用）
ENV NODE_OPTIONS="--max-old-space-size=200"
ENV HOST=0.0.0.0
ENV PORT=3000

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --retries=5 --start-period=30s \
    CMD curl -f http://localhost:3000/ || exit 1

# Nuxt 4 通过 node .output/server/index.mjs 启动 SSR 服务
CMD ["node", ".output/server/index.mjs"]
