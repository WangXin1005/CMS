,IAAA;AAAA,sBAAA,aAAA,MAAA,EAAA,KAAA;AAAA,oBACI,GAAA,MAAA,GAAA,CAAA,cAAA,uBAAA,aAAA,CAAA,KAAA,EAAA,SAAA,cAAAD,UAAA,GAAAC,YAAA,qBAAA;AAAA,sBAQ3B,KAAA;AAAA;sBAJuB,uBAAA,CAAA,WAAA,SAAA,MAAA,EAAA,GAAA,IAAA;AAAA,sBAAA,MAAA;AAAA,sBAClB,MAAA;AAAA,sBACE,aAAA,MAAA,EAAA,KAAA;AAAA,oBACoB,GAAA,MAAA,GAAA,CAAA,cAAA,uBAAA,aAAA,CAAA,KAAA,EAAA,SAAA,WAAAD,UAAA,GAAAC,YAAAC,UAAA,EAAA,KAAA,KAAA;AAAA,sBAQlBC,YAAA,OAAA,EAAA,OAAA,EAAA,WAAA,QAAA,eAAA,UAAA,OAAA,OAAA,SAAA,OAAA,EAAA,GAAA;AAAA,wBALsDA,YAAA,qBAAA;AAAA,0BAC0B,YAAA,SAAA,MAAA,EAAA,GAAA;AAAA,0BAAtD,uBAAA,CAAA,WAAA,SAAA,MAAA,EAAA,GAAA,IAAA;AAAA,0BAAA,aAAA;AAAA,0BAAe,UAAA;AAAA,0BAAa,OAAA,EAAA,QAAA,IAAA;AAAA,wBAAS,GAAA,MAAA,GAAA,CAAA,cAAA,qBAAA,CAAA;AAAA,wBACtEA,YAAA,sBAAA;AAAA,0BAAwE,SAAA;AAAA,0BAArD,OAAA,EAAA,eAAA,IAAA;AAAA,wBAAiB,GAAA;AAAA;4BAAwBC,gBAAA,IAAA;AAAA,0BAAA,CAAA;AAAA;;;sBAEnD,SAAA,MAAA,EAAA,GAAA,KAAAJ,UAAA,GAAAC,YAAA,OAAA;AAAA,wBAA4I,KAAA;AAAA;wBAAvG,OAAA,EAAA,aAAA,SAAA,cAAA,QAAA,cAAA,OAAA,iBAAA,OAAA,UAAA,oBAAA;AAAA,sBAAG,GAAA,MAAA,GAAA,CAAA,KAAA,CAAA,KAAAI,mBAAA,IAAA,IAAA;AAAA;oBAErDF,YAAA,sBAAA;AAAA,sBAAiG,MAAA;AAAA,sBAAtF,MAAA;AAAA,sBAAU,OAAA,EAAA,eAAA,MAAA;AAAA,sBAAU,SAAA,CAAA,WAAA,YAAA,EAAA,GAAA;AAAA,oBAAiD,GAAA;AAAA;wBAAKC,gBAAA,IAAA;AAAA,sBAAA,CAAA;AAAA;;;;;;;;;;;;;;QAKvE,uBAAA,CAAA,WAAA,mBAAA,QAAA;AAAA,QAAkB,OAAA;AAAA,QAAQ,OAAA;AAAA,QAAa,oBAAA;AAAA,MAAM,GAAA;AAAA;;AACjC,mBAAA,OAAAT,eAAAC,WAAA,EAAA,OAAA,EAAA,WAAA,QAAA,aAAA,QAAA,OAAA,QAAA,cAAA,QAAA,EAAA,GAAAW,qBAAA,MAAA,oBAAA,aAAA,KAAA,CAAA,CAAA,CAAA,GAAA,QAAA,GAAA;AACX,gBAAA,CAAA,aAAA,SAAA,UAAA,MAAA,WAAA,GAAA;AAAwC,qBAAAC,mBAAA,qBAAA,EAAA,aAAA,OAAA,GAAA,MAAA,UAAA,QAAA,CAAA;AAAA,YAAkB,OAAA;;;;AAE7DX,0BAAA,UAAA,OAAA,CAAA,MAAA;AAEZ,qBAAA,eAAAE,eAAA,CAAA,EAAA,SAAA,SAAA,UAAA,WAAA,UAAA,yBAAA,iBAAA,OAAA,YAAA,UAAA,cAAA,UAAA,GAAA,EAAA,aAAA,SAAA,MAAA,cAAA,EAAA,MAAA,YAAA,cAAA,CAAA,CAAA,CAAA,IAAA,QAAA,QAAAD,cAAA,OAAA,EAAA,GAAA,CAAA,WAAAC,eAAA,EAAA,SAAA,QAAA,UAAA,SAAA,cAAA,SAAA,WAAA,QAAA,CAAA,CAAA,IAAA,QAAA,gBAAAA,eAAA,EAAA,WAAA,WAAA,aAAA,QAAA,SAAA,QAAA,cAAA,UAAA,YAAA,UAAA,iBAAA,YAAA,eAAA,SAAA,CAAA,CAAA,IAAA,QAAA,IAAAU,eAAA,EAAA,gBAAA,EAAA,QAAA,CAAA,cAAA;AAAA;;;;cALJC,gBAAAV,UAAA,GAAAC,YAAA,OAAA,EAAA,OAAA,EAAA,WAAA,QAAA,aAAA,QAAA,OAAA,QAAA,cAAA,QAAA,KAAA;AAAA,gBAA2F,CAAA,aAAA,SAAA,UAAA,MAAA,WAAA,KAAAD,UAAA,GAAAC,YAAA,qBAAA;AAAA,kBACX,KAAA;AAAA;gBAAT,CAAA,KAAAI,mBAAA,IAAA,IAAA;AAAA,iBACrEL,UAAA,IAAA,GAAAC,YAAAC,UAAA,MAAAI,WAAA,UAAA,OAAA,CAAA,MAAA;AAAA,yBAAAN,UAAA,GAAAC,YAAA,OAAA;AAAA,oBASM,KAAA,EAAA;AAAA,oBAPI,OAAA,CAAA,EAAA,SAAA,SAAA,UAAA,WAAA,UAAA,yBAAA,iBAAA,OAAA,YAAA,UAAA,cAAA,UAAA,GAAA,EAAA,aAAA,SAAA,MAAA,cAAA,EAAA,MAAA,YAAA,cAAA,CAAA;AAAA,oBAE2C,SAAA,CAAA,WAAA,YAAA,EAAA,GAAA;AAAA,kBAC1B,GAAA;AAAA,oBAEzBE,YAAA,OAAA;AAAA,sBAAmF,KAAA,EAAA;AAAA,sBAAtE,OAAA,EAAA,SAAA,QAAA,UAAA,SAAA,cAAA,SAAA,WAAA,QAAA;AAAA,oBAAK,GAAA,MAAA,GAAA,CAAA,KAAA,CAAA;AAAA;kBACgJ,GAAA,IAAA,CAAA,SAAA,CAAA;AAAA;;gBAVtJ,CAAA,oBAAA,aAAA,KAAA;AAAA,cAAY,CAAA;AAAA;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_ssrRenderList","_ssrRenderAttr","_ssrRenderStyle","_openBlock","_createBlock","_Fragment","_createVNode","_createTextVNode","_createCommentVNode","_renderList","_ssrGetDirectiveProps","_ssrRenderComponent","_ssrInterpolate","_withDirectives"],"sources":["../../../../../../../app/pages/setting.vue"],"sourcesContent":["<!-- Setting -- 站点设置页（仅 SUPERADMIN）：站点名称、描述、Logo 等配置 -->\n<script lang=\"ts\" setup>\n/**\n * Setting -- 站点设置页面\n * 读写 SiteSetting API，预设 key：site_name / site_description / site_logo / icp_number。需 auth 中间件保护。\n */\nimport { ref, onMounted } from 'vue'\nimport { ElMessage } from 'element-plus'\nimport request from '~/utils/request'\nimport { useMedia } from '~/composables/useMedia'\ndefinePageMeta({ middleware: 'auth' })\n\nconst loading = ref(false)\nconst { getList: getMediaList } = useMedia()\nconst mediaDialogVisible = ref(false)\nconst mediaList = ref([])\nconst mediaLoading = ref(false)\n\nasync function openMediaPicker() {\n  mediaDialogVisible.value = true\n  mediaLoading.value = true\n  try {\n    const res = await getMediaList()\n    mediaList.value = Array.isArray(res) ? res.filter(m => m.mimeType && m.mimeType.startsWith('image/')) : []\n  } catch { mediaList.value = [] }\n  finally { mediaLoading.value = false }\n}\n\nfunction selectMedia(url) {\n  settings.value.site_logo = url\n  mediaDialogVisible.value = false\n}\n\nconst settings = ref<Record<string, string>>({\n  site_name: '',\n  site_description: '',\n  site_logo: '',\n  icp_number: '',\n})\nconst settingKeys = [\n  { key: 'site_name', label: '网站名称', type: 'text' },\n  { key: 'site_description', label: '网站描述', type: 'textarea' },\n  { key: 'site_logo', label: 'Logo', type: 'image' },\n  { key: 'icp_number', label: '备案号', type: 'text' },\n]\n\nasync function loadSettings() {\n  try {\n    const res = await request.get('/admin/settings')\n    const list = res.data ?? []\n    list.forEach((item) => {\n      if (item.settingKey in settings.value)\n        settings.value[item.settingKey] = item.settingValue ?? ''\n    })\n  } catch { /* ignore */ }\n}\n\nasync function saveSetting(key) {\n  try {\n    await request.put(`/admin/settings/${key}`, { value: settings.value[key] })\n    ElMessage.success('保存成功')\n  } catch { /* 拦截器已处理 */ }\n}\n\nasync function saveAll() {\n  loading.value = true\n  try {\n    await Promise.all(\n      settingKeys.map((s) =>\n        request.put(`/admin/settings/${s.key}`, { value: settings.value[s.key] }),\n      ),\n    )\n    ElMessage.success('全部设置已保存')\n  } catch { /* 拦截器已处理 */ }\n  finally { loading.value = false }\n}\n\nonMounted(loadSettings)\n</script>\n\n<template>\n  <div style=\"flex:1; min-height:0; display:flex; flex-direction:column\">\n    <div class=\"page-header\">\n      <h2>站点设置</h2>\n      <el-button type=\"primary\" :loading=\"loading\" @click=\"saveAll\">保存全部</el-button>\n    </div>\n    <div class=\"page-card\" style=\"flex:1; min-height:0; overflow:auto\">\n      <el-form label-width=\"120px\" style=\"max-width: 640px\">\n        <el-form-item v-for=\"s in settingKeys\" :key=\"s.key\" :label=\"s.label\">\n          <el-input\n            v-if=\"s.type === 'text'\"\n            v-model=\"settings[s.key]\"\n            :placeholder=\"`请输入${s.label}`\"\n          />\n          <el-input\n            v-else-if=\"s.type === 'textarea'\"\n            v-model=\"settings[s.key]\"\n            type=\"textarea\"\n            :rows=\"3\"\n            :placeholder=\"`请输入${s.label}`\"\n          />\n          <template v-else-if=\"s.type === 'image'\">\n            <div style=\"display:flex;align-items:center;gap:8px;width:100%\">\n              <el-input v-model=\"settings[s.key]\" placeholder=\"点击右侧按钮选择图片\" readonly style=\"flex:1\" />\n              <el-button @click=\"openMediaPicker\" style=\"flex-shrink:0\">选择</el-button>\n            </div>\n            <img v-if=\"settings[s.key]\" :src=\"settings[s.key]\" style=\"max-width:200px;max-height:80px;margin-top:8px;border-radius:4px;border:1px solid #e8e8e8\" />\n          </template>\n          <el-button link type=\"primary\" style=\"margin-left:8px\" @click=\"saveSetting(s.key)\">保存</el-button>\n        </el-form-item>\n      </el-form>\n    </div>\n\n    <el-dialog v-model=\"mediaDialogVisible\" title=\"选择图片\" width=\"700\" destroy-on-close>\n      <div v-loading=\"mediaLoading\" style=\"display:flex;flex-wrap:wrap;gap:12px;min-height:100px\">\n        <el-empty v-if=\"!mediaLoading && mediaList.length === 0\" description=\"暂无图片\" />\n        <div\n          v-for=\"m in mediaList\"\n          :key=\"m.id\"\n          style=\"width:140px;cursor:pointer;border:2px solid transparent;border-radius:8px;overflow:hidden;transition:all .2s\"\n          :style=\"{ borderColor: settings.site_logo === m.url ? '#409eff' : 'transparent' }\"\n          @click=\"selectMedia(m.url)\"\n        >\n          <img :src=\"m.url\" style=\"width:100%;height:100px;object-fit:cover;display:block\" />\n          <div style=\"padding:4px 8px;font-size:12px;color:#666;text-align:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap\">{{ m.originalName || m.filename }}</div>\n        </div>\n      </div>\n    </el-dialog>\n  </div>\n</template>\n"],"version":3}