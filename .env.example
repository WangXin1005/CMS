# ============================================================
# CodeBlog CMS — 环境变量配置
# 复制此文件为 .env 并修改实际值： cp .env.example .env
# ============================================================

# --- 部署阶段 ---
# "filing" = 备案期（IP + HTTP）
# "production" = 备案完成（域名 + HTTPS）
DEPLOY_STAGE=filing

# --- 域名（备案完成后填写）---
# 备案期间留空，不影响 IP 访问
DOMAIN=gocms.top

# --- Let's Encrypt 证书通知邮箱 ---
EMAIL=1005495524@qq.com

# --- MySQL 数据库 ---
DB_ROOT_PASSWORD=Still0.0Memory
DB_NAME=nuxt_test_db

# --- JWT 密钥（务必修改！openssl rand -base64 32 生成）---
JWT_SECRET=tI1B1bbOwgnSMl86U4vMzFR81wekXmEHlnUDY0/v7YY=

# Token 过期时间（毫秒），86400000 = 24小时
JWT_EXPIRATION=86400000

# --- CORS 跨域白名单（多个用逗号分隔）---
# 备案期间示例：http://你的服务器IP,http://你的服务器IP:3000
# 备案完成后由 setup-ssl.sh 自动更新为：https://域名,https://www.域名
CORS_ORIGINS=http://47.95.227.211:3000

# --- GitHub Container Registry 仓库所有者 ---
GITHUB_REPO_OWNER=WangXin1005
