# ============================================================
# CodeBlog CMS — 环境变量配置
# 复制为 .env 并修改实际值：cp .env.example .env
# ============================================================

# ========== 数据库 ==========
DB_ROOT_PASSWORD=ChangeMe123!
DB_NAME=nuxt_test_db

# ========== JWT 认证 ==========
# 生成密钥：openssl rand -base64 32
JWT_SECRET=ChangeMeToARandomBase64String
JWT_EXPIRATION=86400000

# ========== 域名（备案完成后填写） ==========
DOMAIN=your-domain.com

# ========== Let's Encrypt 通知邮箱 ==========
EMAIL=your-email@example.com

# ========== CORS 跨域白名单 ==========
# 备案期间：http://服务器IP,http://服务器IP:3000
# 备案完成后：https://你的域名,https://www.你的域名
CORS_ORIGINS=http://localhost:3000

# ========== Gitee Webhook ==========
# Gitee 仓库 Webhook 密码（在 Gitee 仓库设置 → Webhooks 中配置）
WEBHOOK_SECRET=ChangeMeWebhookSecret
# Webhook 监听端口
WEBHOOK_PORT=9000
# 触发部署的目标分支
WEBHOOK_BRANCH=main
